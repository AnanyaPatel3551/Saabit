# Secrets and local tooling
.env
.git
.github
.claude
CLAUDE.md

# Build outputs and dependencies (rebuilt inside the image)
**/.venv
**/node_modules
**/__pycache__
**/.pytest_cache
**/.ruff_cache
frontend/dist

# Not needed at runtime yet
docs
notebooks
eval

# Uploaded datasets must never be baked into the image; the sample cache is rebuilt inside it
**/storage
**/sample_cache

# Only the compressed sample goes into the image
data/*
!data/sample
data/sample/*
!data/sample/amazon_sale_report.csv.gz
